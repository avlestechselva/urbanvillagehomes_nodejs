                </div>
            </div>
            <div class="col-lg-6 intro_col">
                <div class="intro_image">
                    <iframe width="100%" height="315" src="https://www.youtube.com/embed/paW1T11FAZc" frameborder="0" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                </div>
