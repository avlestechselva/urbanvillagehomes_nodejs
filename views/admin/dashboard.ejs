<%- include('_head', { pageTitle: 'Blog Posts' }) %>
<%- include('_nav', { active: 'posts' }) %>

<div class="content-header">
    <h2>Blog Posts (<%= posts.length %>)</h2>
    <a href="/uvh-back-office/posts/new" class="btn btn-primary">+ New Post</a>
</div>

<table>
    <thead>
        <tr><th>Title</th><th>Status</th><th>Date</th><th>Actions</th></tr>
    </thead>
    <tbody>
    <% posts.forEach(post => { %>
    <tr>
        <td><strong><%= post.title ? post.title.substring(0,70) : '(no title)' %></strong></td>
        <td><span class="badge badge-<%= (post.status || '').toLowerCase() %>"><%= post.status %></span></td>
        <td><%= post.createdAt ? new Date(post.createdAt).toLocaleDateString('en-GB') : '' %></td>
        <td>
            <div class="tbl-actions">
                <a href="/uvh-back-office/posts/<%= post._id %>/edit" class="btn btn-sm btn-secondary">Edit</a>
                <% if (post.slug && post.status === 'PUBLISHED') { %>
                <a href="/blog/view/<%= post.slug %>" class="btn btn-sm btn-secondary" target="_blank">View</a>
                <% } %>
                <form method="POST" action="/uvh-back-office/posts/<%= post._id %>/delete" style="display:inline" onsubmit="return confirm('Delete this post?')">
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
            </div>
        </td>
    </tr>
    <% }); %>
    </tbody>
</table>

</main>
</div>
</body>
</html>
