<%- include('_head', { pageTitle: category ? 'Edit Category' : 'New Category' }) %>
<%- include('_nav', { active: 'categories' }) %>

<div class="content-header">
    <h2><%= category ? 'Edit Category' : 'New Category' %></h2>
    <a href="/uvh-back-office/categories" class="btn btn-secondary">← Back</a>
</div>

<div class="card" style="max-width:560px">
    <% if (error) { %><div class="alert-error"><%= error %></div><% } %>

    <form method="POST" action="/uvh-back-office/categories/<%= category ? category._id + '/edit' : 'new' %>">
        <div class="form-group">
            <label for="name">Name *</label>
            <input type="text" id="name" name="name" required value="<%= category ? category.name || '' : '' %>">
        </div>

        <div class="row">
            <div class="form-group">
                <label for="parent">Parent Category</label>
                <select id="parent" name="parent">
                    <option value="">— None (top-level) —</option>
                    <% parents.forEach(p => { %>
                    <option value="<%= p._id %>" <%= (category && category.parent && category.parent.toString() === p._id.toString()) ? 'selected' : '' %>><%= p.name %></option>
                    <% }); %>
                </select>
            </div>
            <div class="form-group">
                <label for="order">Order</label>
                <input type="number" id="order" name="order" value="<%= category ? category.order || 0 : 0 %>" min="0">
            </div>
        </div>

        <div class="actions">
            <button type="submit" class="btn btn-primary"><%= category ? 'Save Changes' : 'Create Category' %></button>
            <a href="/uvh-back-office/categories" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

</main>
</div>
</body>
</html>
